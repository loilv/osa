<odoo>
    <data noupdate="1">

        <!-- Set noupdate = False -->
        <function model="ir.model.data" name="write">
            <function model="ir.model.data" name="search">
                <value eval="[('module','=','crm'), ('name','=','stage_lead1')]"/>
            </function>
            <value eval="{'noupdate': False}"/>
        </function>

        <function model="ir.model.data" name="write">
            <function model="ir.model.data" name="search">
                <value eval="[('module','=','crm'), ('name','=','stage_lead2')]"/>
            </function>
            <value eval="{'noupdate': False}"/>
        </function>

        <function model="ir.model.data" name="write">
            <function model="ir.model.data" name="search">
                <value eval="[('module','=','crm'), ('name','=','stage_lead3')]"/>
            </function>
            <value eval="{'noupdate': False}"/>
        </function>

        <function model="ir.model.data" name="write">
            <function model="ir.model.data" name="search">
                <value eval="[('module','=','crm'), ('name','=','stage_lead4')]"/>
            </function>
            <value eval="{'noupdate': False}"/>
        </function>


        <!-- Xoá stage mặc định -->
        <record model="crm.stage" id="crm.stage_lead1">
            <field name="active" eval="False"/>
        </record>
        <record model="crm.stage" id="crm.stage_lead2">
            <field name="active" eval="False"/>
        </record>
        <record model="crm.stage" id="crm.stage_lead3">
            <field name="active" eval="False"/>
        </record>
        <record model="crm.stage" id="crm.stage_lead4">
            <field name="active" eval="False"/>
        </record>


        <record id="stage_new" model="crm.stage">
            <field name="name">Mới</field>
            <field name="sequence">1</field>
            <field name="color">11</field>
            <field name="is_new" eval="True"/>
        </record>

        <record id="stage_lost" model="crm.stage">
            <field name="name">Loại bỏ</field>
            <field name="sequence">2</field>
            <field name="color">2</field>
        </record>

        <record id="stage_success" model="crm.stage">
            <field name="name">Thành công</field>
            <field name="sequence">3</field>
            <field name="color">10</field>
            <field name="is_won" eval="True"/>
        </record>

        <record id="stage_callback" model="crm.stage">
            <field name="name">Hẹn gọi lại</field>
            <field name="sequence">4</field>
            <field name="color">4</field>
        </record>

        <record id="stage_consultant" model="crm.stage">
            <field name="name">Tư vấn</field>
            <field name="sequence">5</field>
            <field name="color">5</field>
        </record>

    </data>
</odoo>