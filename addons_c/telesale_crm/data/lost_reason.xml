<odoo>
    <data noupdate="1">

        <!-- Set noupdate = False -->
        <function model="ir.model.data" name="write">
            <function model="ir.model.data" name="search">
                <value eval="[('module','=','crm'), ('name','=','lost_reason_1')]"/>
            </function>
            <value eval="{'noupdate': False}"/>
        </function>

        <function model="ir.model.data" name="write">
            <function model="ir.model.data" name="search">
                <value eval="[('module','=','crm'), ('name','=','lost_reason_2')]"/>
            </function>
            <value eval="{'noupdate': False}"/>
        </function>

        <function model="ir.model.data" name="write">
            <function model="ir.model.data" name="search">
                <value eval="[('module','=','crm'), ('name','=','lost_reason_3')]"/>
            </function>
            <value eval="{'noupdate': False}"/>
        </function>


        <!-- Xoá stage mặc định -->
        <record model="crm.lost.reason" id="crm.lost_reason_1">
            <field name="active" eval="False"/>
        </record>
        <record model="crm.lost.reason" id="crm.lost_reason_3">
            <field name="active" eval="False"/>
        </record>
        <record model="crm.lost.reason" id="crm.lost_reason_3">
            <field name="active" eval="False"/>
        </record>

        <record id="reason_purchased" model="crm.lost.reason">
            <field name="name">Đã mua bảo hiểm</field>
            <field name="code">purchased</field>
        </record>

        <record id="reason_invalid_insurance_date" model="crm.lost.reason">
            <field name="name">Sai hạn bảo hiểm</field>
            <field name="code">invalid_insurance_date</field>
        </record>

        <record id="reason_not_care" model="crm.lost.reason">
            <field name="name">Không có nhu cầu</field>
            <field name="code">not_care</field>
        </record>

        <record id="reason_not_partner_information" model="crm.lost.reason">
            <field name="name">Chưa có thông tin khách hàng</field>
            <field name="code">not_partner_information</field>
        </record>

        <record id="reason_unable" model="crm.lost.reason">
            <field name="name">Không liên lạc được</field>
            <field name="code">unable</field>
        </record>

    </data>
</odoo>