<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="campaign_assign_view_form" model="ir.ui.view">
            <field name="name">campaign.assign.form</field>
            <field name="model">crm.campaign.assign.wizard</field>
            <field name="arch" type="xml">
                <form string="campaign_assign_form">
                    <sheet>
                        <group string="Điều kiện">
                            <field name="state"/>
                            <field name="user_filter_id"/>
                            <field name="distribute_type"/>
                        </group>
                        <group string="Chọn người phân công">
                            <field name="type"/>
                            <field name="group_id" invisible="type != 'group'"/>
                            <field name="agent_ids" invisible="type != 'agent'">
                                <form>
                                    <group>
                                        <group>
                                            <field name="name"/>
                                        </group>
                                        <group>
                                            <field name="login"/>
                                        </group>
                                    </group>
                                </form>
                                <list>
                                    <field name="name"/>
                                    <field name="login"/>
                                </list>
                            </field>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Phân bổ" type="object" name="action_assign" class="btn btn-primary"/>
                        <button string="Huỷ" special="cancel" class="btn btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
        
        <record id="campaign_assign_action" model="ir.actions.act_window">
            <field name="name">Phân chia cơ hội theo điều kiện</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">crm.campaign.assign.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>