<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="schedule_callback_view_form" model="ir.ui.view">
            <field name="name">schedule.callback</field>
            <field name="model">crm.schedule.callback</field>
            <field name="arch" type="xml">
                <form string="schedule_callback_form">
                    <sheet>
                        <group>
                            <field name="date"/>
                            <field name="note"/>
                        </group>
                    </sheet>

                    <footer>
                        <button string="Lưu" type="object" name="action_done" class="btn btn-primary"/>
                        <button string="Huỷ" special="cancel" class="btn btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="schedule_callback_action" model="ir.actions.act_window">
            <field name="name">Hẹn gọi lại</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">crm.schedule.callback</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>