<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="assign_lead_view_form" model="ir.ui.view">
            <field name="name">assign_lead_view_form</field>
            <field name="model">wizard.assign.lead</field>
            <field name="arch" type="xml">
                <form string="assign_lead_form">
                    <sheet>
                        <group>
                            <field name="type"/>
                            <field name="group_id" invisible="type != 'group'"/>
                            <field name="agent_ids" invisible="type != 'agent'">
                                <form>
                                    <group>
                                        <group>
                                            <field name="name"/>
                                        </group>
                                        <group>
                                            <field name="login"/>
                                        </group>
                                    </group>
                                </form>
                                <list>
                                    <field name="name"/>
                                    <field name="login"/>
                                </list>
                            </field>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Phân bổ" type="object" name="action_assign" class="btn btn-primary"/>
                        <button string="Huỷ" special="cancel" class="btn btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="assign_lead_action" model="ir.actions.act_window">
            <field name="name">Phân bổ cơ hội</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">wizard.assign.lead</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>