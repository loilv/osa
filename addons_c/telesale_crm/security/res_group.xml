<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record model="ir.module.category" id="module_category_crm">
            <field name="name">CRM</field>
            <field name="sequence">11</field>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_crm">
            <field name="name">CRM</field>
            <field name="category_id" ref="telesale_crm.module_category_crm"/>
            <field name="sequence">7</field>
        </record>

        <record id="group_crm_user" model="res.groups">
            <field name="name">CRM User</field>
            <field name="privilege_id" ref="res_groups_privilege_crm"/>
        </record>

        <record id="group_crm_manager" model="res.groups">
            <field name="name">CRM Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_crm"/>
            <field name="implied_ids" eval="[(4, ref('group_crm_user'))]"/>
        </record>

        <record id="group_crm_system" model="res.groups">
            <field name="name">CRM System</field>
            <field name="privilege_id" ref="res_groups_privilege_crm"/>
            <field name="implied_ids" eval="[(4, ref('group_crm_manager'))]"/>
        </record>


    </data>
</odoo>