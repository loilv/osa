<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="add_tag_view_form" model="ir.ui.view">
            <field name="name">add_tag_view_form</field>
            <field name="model">crm.lead</field>
            <field name="arch" type="xml">
                <form string="add_tag_form">
                    <sheet>
                        <group>
                            <field name="tag_ids" string="Nhãn" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Lưu" class="btn-secondary" special="save" data-hotkey="s"/>
                        <button string="Huỷ" class="btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="add_tag_action" model="ir.actions.act_window">
            <field name="name">Gán nhãn</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">crm.lead</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'form', 'view_id': ref('add_tag_view_form')}),
            ]"/>
        </record>

    </data>
</odoo>