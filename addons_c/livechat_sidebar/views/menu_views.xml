<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="livechat_sidebar_chat_action" model="ir.actions.act_window">
        <field name="name">Zalo Chat</field>
        <field name="res_model">discuss.channel</field>
        <field name="view_mode">form</field>
        <field name="domain">[('livechat_channel_id', '!=', False)]</field>
        <field name="search_view_id" ref="im_livechat.discuss_channel_view_search"/>
        <field name="context">{'search_default_filter_my_sessions': 1, 'search_default_ongoing': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có phiên trò chuyện nào.
            </p>
            <p>Bắt đầu cuộc trò chuyện để hiển thị lịch sử chat.</p>
        </field>
    </record>

<!--    <record id="livechat_sidebar_chat_action_list" model="ir.actions.act_window.view">-->
<!--        <field name="sequence">1</field>-->
<!--        <field name="view_mode">list</field>-->
<!--        <field name="view_id" ref="livechat_sidebar.custom_discuss_channel_view_tree"/>-->
<!--        <field name="act_window_id" ref="livechat_sidebar_chat_action"/>-->
<!--    </record>-->

    <record id="livechat_sidebar_chat_action_form" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="im_livechat.discuss_channel_view_form"/>
        <field name="act_window_id" ref="livechat_sidebar_chat_action"/>
    </record>

    <menuitem
        id="menu_livechat_sidebar_chat_root"
        name="Zalo "
        web_icon="livechat_sidebar,static/description/icon.png"
        sequence="25"/>

    <menuitem
        id="menu_livechat_sidebar_chat_sessions"
        name="Trò chuyện của tôi"
        action="livechat_sidebar_chat_action"
        parent="menu_livechat_sidebar_chat_root"
        sequence="10"/>

    <menuitem
        id="menu_livechat_sidebar_zalo_accounts"
        name="Tài khoản Zalo"
        action="zalo_account_action"
        parent="menu_livechat_sidebar_chat_root"
        sequence="90"/>

</odoo>
