<?xml version="1.0" encoding="UTF-8"?>
<odoo>
      <!-- ============================================================ -->
      <!-- API Scope – Tree View                                        -->
      <!-- ============================================================ -->
      <record id="view_api_scope_tree" model="ir.ui.view">
            <field name="name">api.scope.tree</field>
            <field name="model">api.scope</field>
            <field name="arch" type="xml">
                  <list string="API Scopes" editable="bottom">
                        <field name="name" />
                        <field name="code" />
                        <field name="model_name" />
                        <field name="perm_read" />
                        <field name="perm_write" />
                        <field name="perm_create" />
                        <field name="perm_unlink" />
                        <field name="active" />
                  </list>
            </field>
      </record>

      <!-- ============================================================ -->
      <!-- API Scope – Form View                                        -->
      <!-- ============================================================ -->
      <record id="view_api_scope_form" model="ir.ui.view">
            <field name="name">api.scope.form</field>
            <field name="model">api.scope</field>
            <field name="arch" type="xml">
                  <form string="API Scope">
                        <sheet>
                              <group>
                                    <group>
                                          <field name="name" />
                                          <field name="code" />
                                          <field name="model_name" />
                                          <field name="active" />
                                    </group>
                                    <group string="Permissions">
                                          <field name="perm_read" />
                                          <field name="perm_write" />
                                          <field name="perm_create" />
                                          <field name="perm_unlink" />
                                    </group>
                              </group>
                              <field name="description" placeholder="Describe this scope..." />
                        </sheet>
                  </form>
            </field>
      </record>

      <!-- ============================================================ -->
      <!-- API Scope – Action                                           -->
      <!-- ============================================================ -->
      <record id="action_api_scope" model="ir.actions.act_window">
            <field name="name">API Scopes</field>
            <field name="res_model">api.scope</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                  <p class="o_view_nocontent_smiling_face">
                        Define API permission scopes
                  </p>
                  <p>Scopes control what each API key is allowed to access.</p>
            </field>
      </record>
</odoo>