# Asterisk AMI Connection
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USERNAME=admin
AMI_SECRET=your_ami_secret

# Odoo Connection
ODOO_URL=http://localhost:8069
ODOO_API_KEY=your_api_key_here

# Recording base URL (where Asterisk recordings are served)
# This is used to construct full recording URLs
RECORDING_BASE_URL=https://your-domain.com/recordings
