# Asterisk AMI Connection (ami_listener.py)
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USERNAME=admin
AMI_SECRET=your_ami_secret

# Kafka (ami_listener.py → producer, kafka_consumer.py → consumer)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=asterisk_ami_events
KAFKA_GROUP_ID=asterisk_odoo_consumer

# Odoo Connection (kafka_consumer.py)
ODOO_URL=http://localhost:8019
ODOO_API_KEY=
MAX_RETRIES=3
